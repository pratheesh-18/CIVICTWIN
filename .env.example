# ==============================================================================
# CivicTwin Backend & AI Microservices Environment Configuration Template
# Copy this file to '.env' and fill in your actual production/staging credentials.
# ==============================================================================

# --- AI & Vision Services ---
# Google Gemini API key for Multimodal Defect Verification (Agent 5)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key for Whisper Audio Transcription (Agent 1 Voice Intake) & Llama Reasoning
GROQ_API_KEY=your_groq_api_key_here

# Google Maps API Key for spatial geocoding & map rendering
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Application Security & Auth ---
# Secret key used for signing session JWT tokens (generate a strong random string in prod)
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# Session cookie name & algorithm
SESSION_COOKIE_NAME=civictwin_session
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Authentication Provider ---
# "mock" for hackathon/demo offline mode, or "twilio_verify" for live SMS verification
OTP_PROVIDER=mock

# Demo bypass credentials
DEMO_MODE=True
DEMO_DEPT_PASSWORD=CivicAdmin@2026

# --- Database & Storage ---
# SQLite default: sqlite:///./civictwin.db, or PostgreSQL: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./civictwin.db

# --- Optional Twilio SMS Integration (used if OTP_PROVIDER=twilio_verify) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
