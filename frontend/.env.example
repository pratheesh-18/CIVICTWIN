# ==============================================================================
# CivicTwin Next.js Frontend Environment Configuration
# Copy this file to '.env.local' for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# ==============================================================================

# Public Google Maps API Key for spatial map rendering and marker pinning
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend FastAPI URL endpoint
# For Local Development: http://localhost:8000/api/v1
# For Vercel Production: https://your-backend-api-domain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
