# ==============================================================================
# CivicTwin Git Ignore Configuration
# ==============================================================================

# Secrets and Environment Variables (NEVER COMMIT SENSITIVE KEYS)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node & Next.js Build Outputs
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# NPM / Yarn / PNPM Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python Cache & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# SQLite & Data files
*.db
*.sqlite3
civictwin.db

# User Uploaded Artifacts & Media
uploads/*
!uploads/.gitkeep

# IDEs & System Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
